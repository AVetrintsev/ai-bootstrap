#!/usr/bin/python3 -I
"""Run the graph owner inside the existing rootless project container."""
import os
import pwd
import re
import sys

account = pwd.getpwuid(os.getuid()).pw_name
if not re.fullmatch(r'aisbx-gh-[1-9][0-9]{0,18}', account) or sys.argv[1:] not in (['run'], ['stop']):
    sys.exit('Expected a GitHub project and run or stop')
environment = dict(os.environ, XDG_RUNTIME_DIR=f'/run/user/{os.getuid()}')
os.execvpe('podman', ['podman', 'exec', '--interactive', 'project', 'python3', '-I',
                    '/opt/ai-project-tools/graph.py', sys.argv[1]], environment)
