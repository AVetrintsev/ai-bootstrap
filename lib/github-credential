#!/usr/bin/python3 -I
"""Git credential helper for the current project."""

import json
import socket
import sys


def main():
    if sys.argv[1:] != ["get"]:
        return
    fields = {}
    for line in sys.stdin:
        if line == "\n":
            break
        key, separator, value = line.rstrip("\n").partition("=")
        if separator:
            fields[key] = value
    if fields.get("protocol") != "https" or fields.get("host") != "github.com":
        return
    request = {"path": fields.get("path", "")}
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(20)
        connection.connect("/run/ai-bootstrap-git/credential.sock")
        connection.sendall(json.dumps(request).encode() + b"\n")
        with connection.makefile("rb") as reply:
            token = json.loads(reply.readline(16384)).get("token")
    if token:
        print(f"username=x-access-token\npassword={token}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError):
        sys.exit(1)
