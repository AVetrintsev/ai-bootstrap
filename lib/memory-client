#!/usr/bin/env python3
"""Bridge MCP stdio to this sandbox's host-owned project socket."""
import select
import socket
import sys
import os
import json


def check():
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(90)
        connection.connect('/run/ai-bootstrap-git/memory.sock')
        with connection.makefile('rwb') as stream:
            for identity, method, params in (
                (1, 'initialize', {'protocolVersion': '2025-03-26', 'capabilities': {},
                                  'clientInfo': {'name': 'installer', 'version': '1'}}),
                (2, 'tools/call', {'name': 'get_episodes', 'arguments': {'num_results': 1}}),
            ):
                stream.write(json.dumps({'jsonrpc': '2.0', 'id': identity,
                                         'method': method, 'params': params}).encode() + b'\n')
                stream.flush()
                response = json.loads(stream.readline(131072))
                if 'error' in response or response.get('result', {}).get('isError'):
                    raise OSError('Memory readiness failed')
                if identity == 1:
                    stream.write(b'{"jsonrpc":"2.0","method":"notifications/initialized"}\n')
                    stream.flush()


def main():
    with socket.socket(socket.AF_UNIX) as connection:
        connection.connect('/run/ai-bootstrap-git/memory.sock')
        inputs = [0, connection]
        while inputs:
            ready, _, _ = select.select(inputs, [], [])
            for source in ready:
                data = os.read(source if source == 0 else connection.fileno(), 65536)
                if source == 0:
                    if data:
                        connection.sendall(data)
                    else:
                        connection.shutdown(socket.SHUT_WR)
                        inputs.remove(0)
                elif data:
                    sys.stdout.buffer.write(data)
                    sys.stdout.buffer.flush()
                else:
                    return


if __name__ == '__main__':
    try:
        if sys.argv[1:] == ['--check']:
            check()
        else:
            main()
    except (OSError, ValueError):
        sys.exit('Project memory is unavailable; retry after the service is restored.')
