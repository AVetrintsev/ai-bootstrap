[Unit]
Description=Agent Server in the persistent project sandbox
Requires=ai-bootstrap-sandbox.service
After=ai-bootstrap-sandbox.service

[Service]
ExecStart=/usr/local/libexec/ai-bootstrap/canvas-exec server
ExecStop=/usr/local/libexec/ai-bootstrap/canvas-exec stop
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
